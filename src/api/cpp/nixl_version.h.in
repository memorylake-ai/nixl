/**
 * @file nixl_version.h (NVIDIA Inference Xfer Library)
 * @brief Version of the NIXL headers, substituted from the Meson project version at configure
 *        time. This describes the headers an application was compiled against, which is not
 *        necessarily the libnixl.so it ends up loading.
 */
#ifndef NIXL_SRC_API_CPP_NIXL_VERSION_H
#define NIXL_SRC_API_CPP_NIXL_VERSION_H

/** @brief Components of the NIXL version, as integers usable in preprocessor comparisons. */
#define NIXL_VERSION_MAJOR @NIXL_VERSION_MAJOR@
#define NIXL_VERSION_MINOR @NIXL_VERSION_MINOR@
#define NIXL_VERSION_PATCH @NIXL_VERSION_PATCH@

/** @brief The same version as a "MAJOR.MINOR.PATCH" string literal, for concatenation. */
#define NIXL_VERSION_STRING "@NIXL_VERSION_STRING@"

#endif // NIXL_SRC_API_CPP_NIXL_VERSION_H
